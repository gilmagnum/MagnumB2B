# copy to .env.local and fill (on the server, host is localhost)
HASH_DB_SERVER=localhost
HASH_DB_PORT=61476
HASH_DB_NAME=magnum12
HASH_DB_USER_RO=magnum_ro
HASH_DB_PASSWORD_RO=
HASH_DB_USER_RW=magnumapp
HASH_DB_PASSWORD_RW=

# Must be 1 to COMMIT orders for any account other than the test account (10)
ORDER_WRITE_ENABLED=0

# HTTP API (bridge/server.js). Token: long random string, shared with /web only.
BRIDGE_TOKEN=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Catalog sync -> Supabase (server only, never in git). service_role bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_INTERVAL_MIN=120
SYNC_QUIET_HOURS=7-19

# Push events to the web app (bridge/events.js). Off while empty.
PUSH_EVENT_URL=https://magnum-b2-b.vercel.app/api/push/event
PUSH_EVENT_SECRET=
PUSH_POLL_SEC=60

# Accounts that may be WRITTEN before ORDER_WRITE_ENABLED=1 (tests). Default: 10. E.g. 10,10830
WRITE_TEST_ACCOUNTS=10

# Stock shown/checked by the app = this warehouse only (vBalByStockWH). Default 1 = main warehouse.
STOCK_WAREHOUSE=1
